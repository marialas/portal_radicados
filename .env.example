# INTECOAL SAS - Configuración de Entorno (.env)

# Autenticación Microsoft MSAL (Cliente / Front-End)
VITE_MSAL_CLIENT_ID="tu_id_de_cliente_azure"
VITE_MSAL_TENANT_ID="tu_id_de_inquilino_azure"
VITE_MSAL_REDIRECT_URI="http://localhost:3000"

# Integración Microsoft Graph API (Servidor / Back-End)
AZURE_CLIENT_ID="tu_id_de_cliente_azure"
AZURE_CLIENT_SECRET="tu_secreto_de_cliente_azure"
AZURE_TENANT_ID="tu_id_de_inquilino_azure"

# Configuración del Sitio de SharePoint
SHAREPOINT_SITE_URL="https://interventoriayconsultoriaal.sharepoint.com/sites/VerificacinRETILAP"
SHAREPOINT_SITE_ID="interventoriayconsultoriaal.sharepoint.com,id_del_sitio,id_del_web"
SHAREPOINT_LIST_ID="Radicaciones_AP"
SHAREPOINT_LIBRARY_ID="Documentos_Radicacion"
ONEDRIVE_FOLDER_ROOT="Radicaciones"

# Remitente Institucional Autorizado para Correos Automáticos
M365_SENDER_EMAIL="interventoriaapalborada@intecoalsas.com"

# Llave de Seguridad JWT para Protección de Endpoints Internos
SECRET_KEY="intecoal_jwt_secret_key_cambiar_en_produccion"
ALLOWED_ORIGINS="*"

